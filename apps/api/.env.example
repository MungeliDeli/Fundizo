# Copy to apps/api/.env (git-ignored) for local settings. Never commit real values.
# In development everything has a safe default matching docker-compose.yml.
# In production every value is required and comes from AWS Secrets Manager.

NODE_ENV=development
PORT=4000
# The API connects as a least-privilege login (no UPDATE/DELETE on the ledger). `pnpm db:migrate`
# creates it in dev from this URL, and runs migrations as the owner (MIGRATION_DATABASE_URL).
DATABASE_URL=postgres://fundizo_api:fundizo_api_dev_only@localhost:5432/fundizo
# MIGRATION_DATABASE_URL=postgres://fundizo:fundizo_dev_only@localhost:5432/fundizo
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info

# Public address of the web app, used in email links (your Codespace URL, or http://localhost:3000).
WEB_BASE_URL=http://localhost:3000

# Secret for hashing one-time codes. Generate one with:  openssl rand -base64 48
AUTH_SECRET=

# ── Email (Brevo) ────────────────────────────────────────────────────────────────
# Leave BREVO_API_KEY empty to see emails on the dev outbox page (/dev/outbox) instead.
# Get a key: Brevo → your name (top right) → SMTP & API → API keys → Generate a new API key.
BREVO_API_KEY=
# Must be a sender you have verified in Brevo (Senders, Domains & Dedicated IPs → Senders).
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Fundizo

# ── SMS (Brevo, prepaid credits) ─────────────────────────────────────────────────
# outbox = texts appear on /dev/outbox (free). brevo = real SMS (uses credits; needs BREVO_API_KEY).
SMS_TRANSPORT=outbox
SMS_SENDER=Fundizo

# ── Photo storage ────────────────────────────────────────────────────────────────
# local = processed photos in apps/api/.storage (git-ignored), served at <WEB_BASE_URL>/media.
STORAGE_DRIVER=local

# ── Google sign-in (optional) ────────────────────────────────────────────────────
# Leave both empty to hide "Continue with Google". Setup steps:
# docs/features/A-12-google-signin.md → "Setting up Google sign-in".
# Authorized redirect URI to register in Google Cloud: <WEB_BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Mobile money (slice 8) ---------------------------------------------------------------
# fake = pretend network (dev only); zynle = ZynlePay. Outside production only the sandbox is allowed.
PAYMENT_PROVIDER=fake
ZYNLE_BASE_URL=https://sandbox.zynlepay.com/zynlepay/jsonapi
ZYNLE_MERCHANT_ID=
ZYNLE_API_ID=
ZYNLE_API_KEY=
# Secret last part of the callback URL: <public web address>/api/payments/callbacks/zynle/<token>
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ZYNLE_CALLBACK_TOKEN=
# kwacha or ngwee: what ZynlePay's integer `amount` means (no default on purpose)
ZYNLE_AMOUNT_UNIT=
ZYNLE_PHONE_FORMAT=international
ZYNLE_FEE_BASIS_POINTS=0
