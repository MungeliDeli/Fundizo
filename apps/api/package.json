    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@fundizo/shared": "workspace:*",
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "drizzle-orm": "0.45.4",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.16",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.4.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
